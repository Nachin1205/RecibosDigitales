FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Directorio de la app
WORKDIR /app/RecibosDigitales

# Dependencias mínimas para el validador (Flask + gunicorn)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir flask gunicorn

# Copiar código necesario
COPY RecibosDigitales /app/RecibosDigitales

# Variables por defecto (se pueden sobreescribir)
ENV VALIDATOR_HOST=0.0.0.0 \
    VALIDATOR_PORT=5000 \
    FLASK_DEBUG=0

# Puerto de escucha
EXPOSE 5000

# Healthcheck simple al endpoint /health (sin depender de wget/curl)
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD \
    python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health').read()" || exit 1

# Ejecutar con gunicorn para producción
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:5000", "app:app"]
